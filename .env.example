# PERPLEXITY_API_KEY: Optional for upcoming Perplexity integration.
# Leave empty until integration is completed.
PERPLEXITY_API_KEY=""

# Google Maps / Places API key for live place search.
# Used by /api/generate-leads to query real businesses on Google Maps in Switzerland.
GOOGLE_MAPS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
